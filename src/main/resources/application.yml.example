spring:
  application:
    name: Welcomekit_BE
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/welcomekit
    username: root
    password: CHANGE_ME
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    properties:
      hibernate:
        show_sql: true
    hibernate:
      ddl-auto: update

  mail:
    host: smtp.gmail.com
    port: 587
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

jwt:
  secret: CHANGE_ME
  expiration: 604800000

app:
  signup:
    email-domain: ${SIGNUP_EMAIL_DOMAIN:}
    admin-invite-code: ${ADMIN_INVITE_CODE:}
    code-ttl-minutes: ${SIGNUP_CODE_TTL_MINUTES:10}
  attendance:
    qr-base-url: ${ATTENDANCE_QR_BASE_URL:https://welcomekitbe.lion.it.kr/api/v3/welcome-kit/attendance/success}

logging.level:
  org.hibernate.SQL: debug

springdoc:
  swagger-ui:
    path: swagger
    try-it-out-enabled: true
    filter: true
    operations-sorter: method
    display-request-duration: true
