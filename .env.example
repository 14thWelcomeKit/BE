# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git 추적 안 함)
# 로컬 개발용 실제 값은 팀에서 Notion 으로 공유. 서버(배포)는 GitHub Secret 사용.
#
# 주의: .env 는 Spring(spring.config.import)이 .properties 로도 읽으므로
#       값 뒤에 인라인 주석(# ...)을 쓰지 말 것. 주석은 항상 별도 줄에.

# DB (docker compose + 앱 공용)
MYSQL_ROOT_PASSWORD=
# 3306 이 이미 쓰이면 3307 등으로
MYSQL_PORT=3306

# SMTP (이메일 인증)
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT (HS512 라 64자 이상 필수)
JWT_SECRET=

# 회원가입 정책 (선택)
SIGNUP_EMAIL_DOMAIN=
ADMIN_INVITE_CODE=
SIGNUP_CODE_TTL_MINUTES=10

# AWS S3 (사진첩 이미지 업로드 presigned URL)
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
