# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git 추적 안 함)
# 로컬 개발용 실제 값은 팀에서 Notion 으로 공유. 서버(배포)는 GitHub Secret 사용.

# ── DB (docker compose + 앱 공용) ──
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306                       # 3306 이 이미 쓰이면 3307 등으로

# ── SMTP (이메일 인증) ──
MAIL_USERNAME=
MAIL_PASSWORD=

# ── JWT ──
JWT_SECRET=

# ── 회원가입 정책 (선택) ──
SIGNUP_EMAIL_DOMAIN=
ADMIN_INVITE_CODE=
SIGNUP_CODE_TTL_MINUTES=10
